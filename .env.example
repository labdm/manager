# Copy the web block to apps/web/.env.local and the Convex block to
# packages/backend/.env.local. Vercel env holds the MCP and production
# values. Leave secrets empty in git.

# --- apps/web/.env.local (Vite exposes only VITE_* to the browser) ---

# Convex deployment URL. Anonymous `convex dev` writes this into
# packages/backend/.env.local as CONVEX_URL or NEXT_PUBLIC_CONVEX_URL.
# Copy the http URL here. Do not commit a deployment URL or deploy key.
VITE_CONVEX_URL=

# Clerk publishable key for the Manager application (pk_test_… or pk_live_…).
VITE_CLERK_PUBLISHABLE_KEY=

# --- packages/backend/.env.local (Convex CLI) ---

CONVEX_DEPLOYMENT=
CONVEX_URL=

# Set on the Convex deployment (not only in .env.local):
#   pnpm --filter @manager/backend exec convex env set CLERK_FRONTEND_API_URL "$CLERK_FRONTEND_API_URL"
# No trailing slash. convex/auth.config.ts reads it. Issuer of the Clerk
# JWT template named "convex".
CLERK_FRONTEND_API_URL=

# Clerk user ids (user_…) promoted to admin by users.ensure. Set on Convex:
#   pnpm --filter @manager/backend exec convex env set ADMIN_CLERK_USER_IDS "$ADMIN_CLERK_USER_IDS"
# Email allowlists are unused: Clerk's default Convex JWT omits email.
ADMIN_CLERK_USER_IDS=

# --- Vercel (apps/mcp functions) and the same MCP_ROLE_SECRET on Convex ---

# Clerk secret and publishable keys for the Manager application.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Convex deployment URL for ConvexHttpClient. Same deployment as VITE_CONVEX_URL.
CONVEX_URL=

# MCP. Exact public URL of /mcp, no query and no trailing slash.
# Production: https://manager.labdm.dev/mcp
# Local `vercel dev`: http://localhost:3000/mcp
# Register that same URL in Clerk Dashboard → Agents → MCP servers.
# aud of the OAuth access token is this URL.
MCP_RESOURCE_URL=

# HMAC for the Convex role lookup. Generate: openssl rand -base64 32
# Set the same value on Vercel and on the Convex deployment:
#   pnpm --filter @manager/backend exec convex env set MCP_ROLE_SECRET "<value>"
# Do not reuse CLERK_SECRET_KEY or a Convex deploy key.
# /mcp returns 503 and names this variable when it is missing.
MCP_ROLE_SECRET=
