# Copy this file to apps/web/.env.local. Next.js and the Convex CLI read
# env from apps/web, not the repo root. Leave values empty in git.

# Convex — start local anonymous Convex first; it writes these into
# apps/web/.env.local. Do not commit a deployment URL or deploy key.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Clerk — https://dashboard.clerk.com
# The Clerk application is not created yet.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Set on the Convex deployment (not only in apps/web/.env.local):
#   pnpm --filter @manager/web exec convex env set CLERK_FRONTEND_API_URL "$CLERK_FRONTEND_API_URL"
# No trailing slash. convex/auth.config.ts and the MCP role lookup read it.
CLERK_FRONTEND_API_URL=

# Clerk user ids (user_…) promoted to admin by users.ensure. Set on Convex:
#   pnpm --filter @manager/web exec convex env set ADMIN_CLERK_USER_IDS "$ADMIN_CLERK_USER_IDS"
# Email allowlists are unused: Clerk's default Convex JWT omits email.
ADMIN_CLERK_USER_IDS=

# MCP. Exact public URL of /mcp, no query and no trailing slash.
# Production: https://manager.labdm.dev/mcp
# Local: http://localhost:3000/mcp
# Register that same URL in Clerk Dashboard → Agents → MCP servers.
# aud of the OAuth access token is this URL.
MCP_RESOURCE_URL=

# HMAC for the Convex role lookup. Generate: openssl rand -base64 32
# Set the same value here and on the Convex deployment:
#   pnpm --filter @manager/web exec convex env set MCP_ROLE_SECRET "<value>"
# Do not reuse CLERK_SECRET_KEY or a Convex deploy key.
# /mcp returns 503 and names this variable when it is missing.
MCP_ROLE_SECRET=
