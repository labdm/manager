{
  "name": "manager",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.x",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "pnpm --filter @manager/web dev",
    "dev:backend": "pnpm --filter @manager/backend dev",
    "build:api": "esbuild scripts/api-entries/mcp.ts --bundle --platform=node --format=esm --outfile=api/mcp-impl.js && esbuild scripts/api-entries/oauth-authorization-server.ts --bundle --platform=node --format=esm --outfile=api/oauth-authorization-server.js && esbuild scripts/api-entries/oauth-protected-resource.ts --bundle --platform=node --format=esm --outfile=api/oauth-protected-resource.js",
    "verify:api": "git diff --exit-code api/ || (echo 'API bundles in api/ are out of date. Run pnpm build:api and commit the changes.' && exit 1)",
    "build": "pnpm build:api && pnpm --filter \"./apps/*\" --filter \"./packages/*\" build",
    "lint": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" lint && eslint api",
    "typecheck": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" typecheck",
    "test": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "packageManager": "pnpm@12.21.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.13.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "type": "module"
}
