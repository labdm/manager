{
  "name": "manager",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.x",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "pnpm --filter @manager/web dev",
    "dev:backend": "pnpm --filter @manager/backend dev",
    "build:api": "esbuild scripts/api-entries/mcp.ts --bundle --platform=node --format=esm --outfile=api/mcp-impl.js && esbuild scripts/api-entries/oauth-authorization-server.ts --bundle --platform=node --format=esm --outfile=api/oauth-authorization-server.js && esbuild scripts/api-entries/oauth-protected-resource.ts --bundle --platform=node --format=esm --outfile=api/oauth-protected-resource.js",
    "verify:api": "git diff --exit-code api/ || (echo 'API bundles in api/ are out of date. Run pnpm build:api and commit the changes.' && exit 1)",
    "build": "pnpm build:api && pnpm --filter \"./apps/*\" --filter \"./packages/*\" build",
    "lint": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" lint && eslint api",
    "typecheck": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" typecheck",
    "test": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" test",
    "desktop:dev": "pnpm --dir apps/desktop tauri dev",
    "desktop:build": "pnpm --dir apps/desktop tauri build",
    "desktop:package": "scripts/package-desktop-artifacts.sh",
    "apple:project": "scripts/apple-project.sh",
    "apple:test": "swift test --package-path apps/apple/Packages/ManagerKit",
    "apple:build:mac": "xcodebuild -project apps/apple/Manager.xcodeproj -scheme Manager -destination 'platform=macOS' -configuration \"${MANAGER_CONFIGURATION:-Debug}\" -derivedDataPath \"${MANAGER_DERIVED_DATA:-apps/apple/.build/derivedData}\" MARKETING_VERSION=\"${MANAGER_VERSION_NUMBER:-0.1.0}\" CODE_SIGNING_ALLOWED=NO build",
    "apple:build:ios": "xcodebuild -project apps/apple/Manager.xcodeproj -scheme Manager -destination 'generic/platform=iOS Simulator' -configuration \"${MANAGER_CONFIGURATION:-Debug}\" -derivedDataPath \"${MANAGER_DERIVED_DATA:-apps/apple/.build/derivedData}\" MARKETING_VERSION=\"${MANAGER_VERSION_NUMBER:-0.1.0}\" CODE_SIGNING_ALLOWED=YES CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=- PROVISIONING_PROFILE_SPECIFIER= build",
    "apple:package": "scripts/package-apple-artifacts.sh",
    "apple:install:ios": "xcrun simctl uninstall booted dev.labdm.manager >/dev/null 2>&1; xcrun simctl install booted \"${MANAGER_DERIVED_DATA:-apps/apple/.build/derivedData}/Build/Products/${MANAGER_CONFIGURATION:-Debug}-iphonesimulator/Manager.app\" && xcrun simctl launch booted dev.labdm.manager",
    "android:test": "scripts/android-gradle.sh test",
    "android:build": "scripts/android-gradle.sh assembleDebug bundleRelease",
    "android:install": "scripts/android-gradle.sh installDebug",
    "android:package": "scripts/package-android-artifacts.sh",
    "check:functions": "scripts/check-convex-functions.sh",
    "deps:scan": "pnpm audit --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "esbuild": "0.28.2",
    "eslint": "^10.15.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0"
  },
  "packageManager": "pnpm@12.21.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.13.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "type": "module"
}
