{
  "name": "manager",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.x",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "pnpm --filter @manager/web dev",
    "dev:backend": "pnpm --filter @manager/backend dev",
    "build": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" build",
    "lint": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" lint && eslint api",
    "typecheck": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" typecheck",
    "test": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.5",
    "typescript-eslint": "^8.73.0",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.16.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.13.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  }
}
